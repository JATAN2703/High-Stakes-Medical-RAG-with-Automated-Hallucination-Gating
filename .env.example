# OpenRouter API Key - get yours at https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model selection (OpenRouter model strings)
GENERATOR_MODEL=openai/gpt-4o-mini
JUDGE_MODEL=anthropic/claude-3.5-sonnet

# Claude models (used when a bare claude-* model is selected, e.g. via
# `run_benchmark.py --model claude-sonnet-5`). Two backends are supported:
#
#   1. Direct Anthropic API (simplest) - set ANTHROPIC_API_KEY. Takes priority.
#   2. Google Vertex AI - set VERTEX_PROJECT_ID and run Google ADC login
#      (`gcloud auth application-default login`). Used only if no API key is set.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
VERTEX_PROJECT_ID=your-gcp-project-id
VERTEX_REGION=global

# ChromaDB settings
CHROMA_PERSIST_DIR=./data/chroma_db

# Experiment tracking (optional)
WANDB_API_KEY=your_wandb_key_here
WANDB_PROJECT=medical-rag-hallucination

# Logging
LOG_LEVEL=INFO
